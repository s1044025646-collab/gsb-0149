{
  "name": "borehole-trajectory-backend",
  "version": "1.0.0",
  "description": "Directional drilling trajectory and inter-well distance evaluation backend (local plane coordinates).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node --experimental-sqlite dist/api/server.js",
    "server:start": "node scripts/start.mjs",
    "server:stop": "node scripts/stop.mjs",
    "dev": "node --experimental-sqlite --experimental-strip-types src/api/server.ts",
    "cli": "node --experimental-sqlite --experimental-strip-types src/cli/cli.ts",
    "demo": "node --import ./test/register-ts.mjs --experimental-sqlite scripts/demo.ts",
    "test": "node --import ./test/register-ts.mjs --experimental-sqlite --test --experimental-strip-types --test-reporter=spec test/*.test.ts",
    "clean": "node scripts/clean.mjs"
  },
 "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.6.0"
  }
}
